// StoargeX – Multi-Tenant SaaS für Handels-GbRs
// Jede mandantenspezifische Tabelle trägt organizationId (Pflicht + Index).
// Harte Datentrennung zusätzlich über Postgres Row Level Security
// (siehe prisma/migrations/..._init/migration.sql, Abschnitt RLS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
  READONLY
}

enum LegalForm {
  GBR
  EINZELUNTERNEHMEN
  UG
  GMBH
  SONSTIGE
}

enum StockItemStatus {
  IN_STOCK      // "gelagert" (neutral)
  STORED_R      // "gelagert - R"
  STORED_D      // "gelagert - D"
  SOLD          // "Verkauft"
  RETURNED      // "Retoure"
  CANCELLED     // "Storniert"
  IN_TRANSIT    // "Unterwegs"
  OTHER         // "Sonstiges"
  LISTED        // Altbestand (UI bietet den Wert nicht mehr an)
  RESERVED      // Altbestand
  WRITTEN_OFF   // Altbestand
}

// Kauf-/Retoure-Buchungsstatus wie im Excel-Original:
// E = eingetragen, O = offen/ausstehend, NN = nicht nötig, S = Sonstiges
enum EntryStatus {
  E
  O
  NN
  S
}

// Konfigurierbare Auswahllisten (Einstellungen), z.B. Zahlungsmethoden (ZM)
// und Auszahlungsempfänger
enum OptionKind {
  PAYMENT_METHOD
  PAYOUT_RECIPIENT
  TASK_AREA
}

enum SaleStatus {
  PENDING    // verkauft, Zahlung offen
  PAID       // bezahlt
  SHIPPED    // versendet
  COMPLETED  // abgeschlossen
  CANCELLED  // storniert
  REFUNDED   // erstattet
}

enum ReturnStatus {
  REQUESTED  // "Angekündigt"
  REJECTED   // "Storniert"
  RESTOCKED  // "Gelagert" (Artikel physisch zurück -> Lagerstatus RETOURE)
  REFUNDED   // "Erstattet"
  CONFLICT   // "Konflikt"
  RECEIVED   // Altwert (UI bietet ihn nicht mehr an)
}

enum ConsignmentStatus {
  RECEIVED   // Kommissionsware angenommen
  LISTED     // inseriert
  SOLD       // verkauft
  PAID_OUT   // Auszahlung an Einlieferer erfolgt
  RETURNED   // an Einlieferer zurückgegeben
}

enum DebtStatus {
  OPEN           // "Offen"
  SETTLED        // "Beglichen"
  OTHER          // "Sonstiges"
  PARTIALLY_PAID // Altwert
}

// Art des Schulden-Eintrags
enum DebtKind {
  KAUF
  VERKAUF
  SONSTIGES
}

// Buchhaltungs-Marker: I.O / Fehlt
enum DebtEntry {
  IO
  FEHLT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

// ---------------------------------------------------------------------------
// Mandanten & Benutzer
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  legalForm LegalForm @default(GBR)
  vatId     String?   @map("vat_id") // USt-IdNr.
  taxNumber String?   @map("tax_number")
  // Format für lesbare Order-IDs; Tokens: {JJJJ} {JJ} {MM} {TT} {NR:n}
  orderIdFormat  String @default("SX-{JJJJ}-{NR:4}") @map("order_id_format")
  orderIdCounter Int    @default(0) @map("order_id_counter")
  // Fortlaufende LagerIDs (Format L-{JJ}-{NNN})
  stockIdCounter Int @default(0) @map("stock_id_counter")
  // Schwellenwert für Niedrig-Bestand-Warnung (Dashboard/Lager)
  lowStockThreshold Int @default(1) @map("low_stock_threshold")
  // Billing (Stripe): Tier wird vom Webhook aktualisiert
  subscriptionTier     SubscriptionTier @default(FREE) @map("subscription_tier")
  stripeCustomerId     String?          @unique @map("stripe_customer_id")
  stripeSubscriptionId String?          @map("stripe_subscription_id")
  street    String?
  zipCode   String?   @map("zip_code")
  city      String?
  country   String    @default("DE")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  memberships   Membership[]
  invitations   Invitation[]
  platforms     Platform[]
  carriers      Carrier[]
  taxRates      TaxRate[]
  stockItems    StockItem[]
  sales         Sale[]
  returns       Return[]
  consignments  ConsignmentInventory[]
  debts         Debt[]
  tasks         Task[]
  credentials   Credential[]
  auditLogs     AuditLog[]
  listings      StockItemListing[]
  shippingRates ShippingRate[]
  saleItems     SaleItem[]
  selectOptions SelectOption[]
  products      Product[]

  @@map("organizations")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash") // null bei reinem OAuth-Login
  // 2FA (TOTP) – Secret verschlüsselt (AES-256-GCM, lib/crypto.ts)
  totpSecret    String?   @map("totp_secret")
  totpEnabled   Boolean   @default(false) @map("totp_enabled")
  recoveryCodes String[]  @default([]) @map("recovery_codes") // argon2-Hashes
  // Dark-Mode-Präferenz: "light" | "dark" | null = Systemeinstellung
  theme         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  sentInvitations Invitation[]
  assignedTasks   Task[]       @relation("TaskAssignee")
  createdTasks    Task[]       @relation("TaskCreator")
  auditLogs       AuditLog[]

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  email          String
  role           Role             @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Stammdaten (mandantenspezifisch)
// ---------------------------------------------------------------------------

model Platform {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String // z.B. eBay, Vinted, Kleinanzeigen
  url               String?
  defaultFeePercent Decimal  @default(0) @map("default_fee_percent") @db.Decimal(5, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]
  credentials  Credential[]
  listings     StockItemListing[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("platforms")
}

// Konfigurierbare Versandtarife (ersetzt feste DHL-Tabelle):
// Zielland + Gewicht -> Grundpreis + Kilopreis + Zuschläge (lib/calculations.ts)
model ShippingRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  carrierName    String   @map("carrier_name") // z.B. DHL, DPD, Hermes, GLS, UPS
  name           String // Tarifname, z.B. "Paket M national"
  zone           String // Zonenlabel, z.B. "DE", "EU", "Welt"
  countries      String[] @default([]) // ISO-2-Länder der Zone; leer = alle
  baseCents      Int      @map("base_cents") // Grundpreis
  perKgCents     Int      @default(0) @map("per_kg_cents") // Kilopreis
  maxWeightKg    Decimal? @map("max_weight_kg") @db.Decimal(6, 2) // optionales Tarif-Limit
  // Zuschläge als JSON: [{ "label": "Sperrgut", "cents": 500 }, ...]
  surcharges     Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("shipping_rates")
}

model Carrier {
  id                  String   @id @default(cuid())
  organizationId      String   @map("organization_id")
  name                String // z.B. DHL, Hermes, DPD
  trackingUrlTemplate String?  @map("tracking_url_template") // z.B. https://.../{tracking}
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("carriers")
}

model TaxRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String // z.B. "Differenzbesteuerung §25a", "Regelsteuersatz 19%"
  ratePercent    Decimal  @map("rate_percent") @db.Decimal(5, 2)
  // ISO-2-Länderkürzel (z.B. "DE", "AT"); null = Fallback für alle Länder.
  // Verkäufe nutzen den Satz des Käuferlands, sonst den Default.
  country        String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItems   StockItem[]
  sales        Sale[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Warenwirtschaft
// ---------------------------------------------------------------------------

model StockItem {
  id                 String          @id @default(cuid())
  organizationId     String          @map("organization_id")
  sku                String // interne Artikelnummer
  title              String
  model              String? // Modell (z.B. "Air Jordan 1 Mid")
  variant            String? // Variante/Colorway
  description        String?
  category           String?
  brand              String?
  size               String?
  condition          String? // z.B. "Neu mit Etikett", "Sehr gut"
  ean                String? // EAN/GTIN
  quantity           Int             @default(1)
  supplier           String? // Händler / Bezugsquelle
  purchasePriceCents Int             @map("purchase_price_cents") // EK brutto in Cent
  // EK netto: bei Vorsteuerabzug = brutto / (1 + Satz), sonst = brutto
  purchaseNetCents   Int?            @map("purchase_net_cents")
  inputTaxDeductible Boolean         @default(false) @map("input_tax_deductible")
  paymentMethod      String?         @map("payment_method") // z.B. PayPal, Bar, Überweisung
  purchaseDate       DateTime?       @map("purchase_date")
  purchaseChannel    String?         @map("purchase_channel") // wo eingekauft
  location           String? // Lagerplatz
  status             StockItemStatus @default(IN_STOCK)
  // Buchungsstatus wie im Excel: Kauf (E/O/NN) und Retoure (E/O/NN/S)
  kaufStatus         EntryStatus     @default(O) @map("kauf_status")
  retoureStatus      EntryStatus     @default(NN) @map("retoure_status")
  imageUrls          String[]        @default([]) @map("image_urls")
  notes              String?
  taxRateId          String?         @map("tax_rate_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate      TaxRate?               @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  sales        Sale[]
  saleItems    SaleItem[]
  consignments ConsignmentInventory[]
  listings     StockItemListing[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("stock_items")
}

// "Gelistet auf": n:m zwischen StockItem und Platform (nicht hartcodiert)
model StockItemListing {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  stockItemId    String   @map("stock_item_id")
  platformId     String   @map("platform_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, platformId])
  @@index([organizationId])
  @@map("stock_item_listings")
}

// Verkaufsposition: verknüpft einen Verkauf mit genau einer Einheit aus dem
// Lager ODER dem Konsignationsbestand (Mehrartikel-Verkäufe = mehrere Zeilen)
model SaleItem {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  saleId         String  @map("sale_id")
  stockItemId    String? @map("stock_item_id")
  consignmentId  String? @map("consignment_id")
  ekNetCents     Int     @default(0) @map("ek_net_cents") // EK-Netto-Snapshot

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItem    StockItem?            @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  consignment  ConsignmentInventory? @relation(fields: [consignmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([saleId])
  @@map("sale_items")
}

// Konfigurierbare Dropdown-Werte (ZM, Auszahlungsempfänger)
model SelectOption {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  kind           OptionKind
  label          String
  sortOrder      Int        @default(0) @map("sort_order")
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, label])
  @@index([organizationId])
  @@map("select_options")
}

// Produktkatalog: wiederkehrende Produkte für schnelles Eintragen
model Product {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String
  variant           String? // Variante/Version
  category          String?
  ean               String?
  defaultPriceCents Int?     @map("default_price_cents") // Standard-EK brutto
  imageUrls         String[] @default([]) @map("image_urls")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, variant])
  @@index([organizationId])
  @@map("products")
}

model Sale {
  id                   String     @id @default(cuid())
  organizationId       String     @map("organization_id")
  stockItemId          String?    @map("stock_item_id") // Alt-Feld; neue Verkäufe nutzen SaleItem
  platformId           String     @map("platform_id")
  carrierId            String?    @map("carrier_id")
  taxRateId            String?    @map("tax_rate_id")
  soldAt               DateTime   @default(now()) @map("sold_at")
  quantity             Int        @default(1)
  salePriceCents       Int        @map("sale_price_cents") // VK brutto in Cent
  // Server-seitig berechnet (lib/calculations.ts) und als Snapshot gespeichert:
  saleNetCents         Int        @default(0) @map("sale_net_cents") // VK netto
  taxRatePercent       Decimal    @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  marginCents          Int        @default(0) @map("margin_cents") // VK netto - EK netto
  profitCents          Int        @default(0) @map("profit_cents") // Marge - Versand - Gebühren
  buyerCountry         String     @default("DE") @map("buyer_country") // ISO-2
  shippingMethod       String?    @map("shipping_method")
  payoutRecipient      String?    @map("payout_recipient") // Auszahlungsempfänger
  shippingChargedCents Int        @default(0) @map("shipping_charged_cents") // Versand vom Käufer
  shippingCostCents    Int        @default(0) @map("shipping_cost_cents") // Versand netto
  platformFeeCents     Int        @default(0) @map("platform_fee_cents") // Plattformgebühren brutto
  platformFeeNetCents  Int        @default(0) @map("platform_fee_net_cents") // berechnet oder manuell
  feeInclVat           Boolean    @default(true) @map("fee_incl_vat") // Gebühren inkl. MwSt?
  paymentFeeCents      Int        @default(0) @map("payment_fee_cents") // Alt-Feld (in Plattformgebühren aufgegangen)
  // Informative Checkbox-Status:
  invoiceCreated       Boolean    @default(false) @map("invoice_created")
  postageBooked        Boolean    @default(false) @map("postage_booked")
  feesBooked           Boolean    @default(false) @map("fees_booked")
  buyerUsername        String?    @map("buyer_username")
  orderNumber          String?    @map("order_number") // lesbare Order-ID (Format konfigurierbar)
  trackingNumber       String?    @map("tracking_number")
  status               SaleStatus @default(PENDING)
  notes                String?
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem?             @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  platform     Platform               @relation(fields: [platformId], references: [id], onDelete: Restrict)
  carrier      Carrier?               @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  taxRate      TaxRate?               @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  items        SaleItem[]
  returns      Return[]
  consignments ConsignmentInventory[]

  @@index([organizationId])
  @@index([organizationId, soldAt])
  @@index([organizationId, status])
  @@map("sales")
}

model Return {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  saleId            String       @map("sale_id") // harter FK auf den Verkauf
  requestedAt       DateTime     @default(now()) @map("requested_at") // Meldedatum
  receivedAt        DateTime?    @map("received_at")
  reason            String?
  refundAmountCents Int          @default(0) @map("refund_amount_cents") // Erstattung brutto
  returnShippingCents Int        @default(0) @map("return_shipping_cents") // Zusatzkosten (z.B. Rückversand)
  // Tatsächlicher finanzieller Verlust, server-seitig berechnet
  // (lib/calculations.ts calcReturnLoss): Erstattung abzüglich enthaltener
  // USt und anteiliger Gebühren/Versand, plus Zusatzkosten.
  lossCents         Int          @default(0) @map("loss_cents")
  status            ReturnStatus @default(REQUESTED)
  restocked         Boolean      @default(false) // wieder in den Bestand aufgenommen?
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("returns")
}

model ConsignmentInventory {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  sku               String // eigene SKU/ID für Fremdfirmen-Ware
  stockItemId       String?           @map("stock_item_id") // optional mit Lagerartikel verknüpft
  saleId            String?           @map("sale_id") // (Alt-Feld) einzelner Verkauf
  consignorName     String            @map("consignor_name") // Partnerfirma / Einlieferer
  consignorContact  String?           @map("consignor_contact")
  itemTitle         String            @map("item_title")
  // Bestandszähler
  quantity          Int               @default(0) // aktueller Bestand
  soldQuantity      Int               @default(0) @map("sold_quantity")
  returnedQuantity  Int               @default(0) @map("returned_quantity")
  defectiveQuantity Int               @default(0) @map("defective_quantity")
  // Mehrere Preisebenen als JSON: [{ "label": "VK Standard", "cents": 4999 }, ...]
  priceTiers        Json              @default("[]") @map("price_tiers")
  // Verknüpfung zu echten Sale-Einträgen für separate Umsatz-/Margen-Auswertung
  linkedSaleIds     String[]          @default([]) @map("linked_sale_ids")
  commissionPercent Decimal?          @map("commission_percent") @db.Decimal(5, 2) // unsere Provision
  agreedPayoutCents Int?              @map("agreed_payout_cents") // alternativ: fester Auszahlungsbetrag
  receivedAt        DateTime          @default(now()) @map("received_at")
  soldAt            DateTime?         @map("sold_at")
  paidOutAt         DateTime?         @map("paid_out_at")
  returnedAt        DateTime?         @map("returned_at")
  status            ConsignmentStatus @default(RECEIVED)
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItems    SaleItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("consignment_inventory")
}

model Debt {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  debtDate       DateTime   @default(now()) @map("debt_date") // Datum der Forderung
  refId          String?    @map("ref_id") // Lager- oder Order-ID
  kind           DebtKind   @default(SONSTIGES) // Kauf / Verkauf / Sonstiges
  quantity       Int        @default(1) // Menge
  entryStatus    DebtEntry  @default(IO) @map("entry_status") // I.O / Fehlt
  creditorName   String     @map("creditor_name") // Empfänger
  debtorName     String     @map("debtor_name") // Schuldner
  amountCents    Int        @map("amount_cents")
  paidCents      Int        @default(0) @map("paid_cents")
  description    String?
  dueDate        DateTime?  @map("due_date")
  status         DebtStatus @default(OPEN)
  settledAt      DateTime?  @map("settled_at")
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("debts")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  title          String
  description    String?
  area           String? // Bereich, z.B. "Einkauf", "Versand", "Buchhaltung"
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(MEDIUM)
  // Erledigte Aufgaben werden archiviert statt gelöscht (Filter im Board)
  archived       Boolean      @default(false)
  dueDate        DateTime?    @map("due_date")
  assigneeId     String?      @map("assignee_id")
  createdById    String       @map("created_by_id")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Credential {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  platformId      String?   @map("platform_id")
  label           String // z.B. "eBay Hauptaccount"
  username        String?
  // Verschlüsselt mit AES-256-GCM (lib/crypto.ts) – niemals Klartext speichern
  secretEncrypted String    @map("secret_encrypted")
  notes           String?
  lastRotatedAt   DateTime? @map("last_rotated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform     Platform?    @relation(fields: [platformId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("credentials")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String // z.B. "sale.create", "member.role_change"
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) Adapter-Tabellen
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
