// StoargeX – Multi-Tenant SaaS für Handels-GbRs
// Jede mandantenspezifische Tabelle trägt organizationId (Pflicht + Index).
// Harte Datentrennung zusätzlich über Postgres Row Level Security
// (siehe prisma/migrations/..._init/migration.sql, Abschnitt RLS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
  READONLY
}

enum LegalForm {
  GBR
  EINZELUNTERNEHMEN
  UG
  GMBH
  SONSTIGE
}

enum StockItemStatus {
  IN_STOCK // "gelagert" (neutral)
  STORED_R // "gelagert - R"
  STORED_D // "gelagert - D"
  SOLD // "Verkauft"
  RETURNED // "Retoure"
  CANCELLED // "Storniert"
  IN_TRANSIT // "Unterwegs"
  OTHER // "Sonstiges"
  LISTED // Altbestand (UI bietet den Wert nicht mehr an)
  RESERVED // Altbestand
  WRITTEN_OFF // Altbestand
}

// Kauf-/Retoure-Buchungsstatus wie im Excel-Original:
// E = eingetragen, O = offen/ausstehend, NN = nicht nötig, S = Sonstiges
enum EntryStatus {
  E
  O
  NN
  S
}

// Konfigurierbare Auswahllisten (Einstellungen), z.B. Zahlungsmethoden (ZM)
// und Auszahlungsempfänger
enum OptionKind {
  PAYMENT_METHOD
  PAYOUT_RECIPIENT
  TASK_AREA
}

enum SaleStatus {
  PENDING // verkauft, Zahlung offen
  PAID // bezahlt
  SHIPPED // versendet
  COMPLETED // abgeschlossen
  CANCELLED // storniert
  REFUNDED // erstattet
}

enum ReturnStatus {
  REQUESTED // "Angekündigt"
  REJECTED // "Storniert"
  RESTOCKED // "Gelagert" (Artikel physisch zurück -> Lagerstatus RETOURE)
  REFUNDED // "Erstattet"
  CONFLICT // "Konflikt"
  RECEIVED // Altwert (UI bietet ihn nicht mehr an)
}

enum ConsignmentStatus {
  RECEIVED // Kommissionsware angenommen
  LISTED // inseriert
  SOLD // verkauft
  PAID_OUT // Auszahlung an Einlieferer erfolgt
  RETURNED // an Einlieferer zurückgegeben
}

enum DebtStatus {
  OPEN // "Offen"
  SETTLED // "Beglichen"
  OTHER // "Sonstiges"
  PARTIALLY_PAID // Altwert
}

// Art des Schulden-Eintrags
enum DebtKind {
  KAUF
  VERKAUF
  SONSTIGES
}

enum DebtType {
  PURCHASE
  SALE
  MANUAL
  OTHER
}

// Buchhaltungs-Marker: I.O / Fehlt
enum DebtEntry {
  IO
  FEHLT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum BusinessPartnerRoleType {
  SUPPLIER
  CONSIGNMENT_PARTNER
  CUSTOMER
  OTHER
}

enum MarketplaceAccountType {
  BUSINESS
  PRIVATE
  MANAGED
  OTHER
}

enum PayoutAccountType {
  BANK
  PAYPAL
  PLATFORM_WALLET
  SHAREHOLDER_PRIVATE
  OTHER
}

enum ItemCondition {
  NEW
  OPEN_BOX
  REFURBISHED
  USED
  DEFECTIVE
}

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ExpenseRecurrenceInterval {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum SupplierReturnStatus {
  DRAFT
  APPROVED
  DISPATCHED
  CREDIT_PENDING
  REPLACEMENT_PENDING
  COMPLETED
  CANCELLED
}

enum TaskScope {
  PERSONAL
  TEAM
}

enum TaskAssignmentRole {
  PRIMARY
  COLLABORATOR
}

enum FeeRuleOrigin {
  MANUAL
  IMPORTED
  SYNCED
}

enum FeeVatTreatment {
  INCLUDED
  EXCLUDED
  EXEMPT
  UNKNOWN
}

enum EntitlementStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
  CANCELLED
}

enum EntitlementSource {
  SUBSCRIPTION
  ADD_ON
  TRIAL
  MANUAL
}

// ---------------------------------------------------------------------------
// Phase 1 (inventory-refactor): additive Enums für neues Datenmodell
// Siehe docs/inventory-refactor-plan.md
// ---------------------------------------------------------------------------

/**
 * Dokumentarten für mandanten- und jahresbezogene Sequenzen.
 */
enum DocumentKind {
  OWNED_STOCK // L-{JJ}-{NNNN}   – eigener Bestand
  CONSIGNMENT // K-{JJ}-{NNNN}   – Konsignationsbestand
  PURCHASE // E-{JJ}-{NNNN}   – Einkauf
  SALE // V-{JJ}-{NNNN}   – Verkauf
  RETURN // R-{JJ}-{NNNN}   – Retoure
  DEBT // SCH-{JJ}-{NNNN} – Schulden-Eintrag
  SUPPLIER_RETURN // LR-{JJ}-{NNNN} – Lieferantenretoure
}

/**
 * Bestandsart einer InventoryPosition.
 */
enum InventoryType {
  OWNED
  CONSIGNMENT
}

/**
 * Status eines Einkaufs (Purchase).
 */
enum PurchaseStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  DRAFT // erfasst, aber noch nicht bestätigt
  CONFIRMED // Bestellung ausgelöst / Ware unterwegs / eingegangen
  CANCELLED // Einkauf storniert
}

enum PurchaseShippingStatus {
  NOT_SHIPPED
  READY
  SHIPPED
  PARTIALLY_RECEIVED
  DELIVERED
  UNKNOWN
}

enum ReceiptInspectionStatus {
  PENDING
  PASSED
  DEFECTIVE
}

enum InventoryBucket {
  AVAILABLE
  RESERVED
  INSPECTION
  DEFECTIVE
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  CONSIGNMENT_RECEIPT
  SALE_OUT
  RESERVE
  RELEASE_RESERVATION
  RETURN_RECEIPT
  RETURN_RESTOCK
  RETURN_DEFECTIVE
  SUPPLIER_RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

enum ImportBatchStatus {
  DRY_RUN
  RUNNING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  UNCHANGED
  UPDATE_AVAILABLE
  NEW
  LINKED
  PARTIALLY_LINKED
  UNRESOLVED
  REVIEW_REQUIRED
  CONFLICT
  ERROR
}

enum ImportTargetEntity {
  PRODUCT
  PURCHASE
  PURCHASE_LINE
  PURCHASE_RECEIPT
  INVENTORY_POSITION
  CONSIGNMENT_LOT
  SALE
  SALE_LINE
  SALE_LINE_ALLOCATION
  RETURN
  RETURN_LINE
  DEBT
  TASK
  BUSINESS_PARTNER
  MARKETPLACE_ACCOUNT
  PAYOUT_ACCOUNT
  EXPENSE_CATEGORY
  EXPENSE
  SUPPLIER_RETURN
  SUPPLIER_RETURN_LINE
  FEE_RULE
  FEATURE_ENTITLEMENT
  LEGACY_ONLY
}

enum HistoricalRelationStatus {
  LINKED
  PARTIALLY_LINKED
  UNRESOLVED
  REVIEW_REQUIRED
}

// ---------------------------------------------------------------------------
// Mandanten & Benutzer
// ---------------------------------------------------------------------------

model Organization {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  legalForm            LegalForm        @default(GBR)
  vatId                String?          @map("vat_id") // USt-IdNr.
  taxNumber            String?          @map("tax_number")
  // Format für lesbare Order-IDs; Tokens: {JJJJ} {JJ} {MM} {TT} {NR:n}
  orderIdFormat        String           @default("SX-{JJJJ}-{NR:4}") @map("order_id_format")
  orderIdCounter       Int              @default(0) @map("order_id_counter")
  // Fortlaufende LagerIDs (Format L-{JJ}-{NNN})
  stockIdCounter       Int              @default(0) @map("stock_id_counter")
  // Schwellenwert für Niedrig-Bestand-Warnung (Dashboard/Lager)
  lowStockThreshold    Int              @default(1) @map("low_stock_threshold")
  // Billing (Stripe): Tier wird vom Webhook aktualisiert
  subscriptionTier     SubscriptionTier @default(FREE) @map("subscription_tier")
  stripeCustomerId     String?          @unique @map("stripe_customer_id")
  stripeSubscriptionId String?          @map("stripe_subscription_id")
  street               String?
  zipCode              String?          @map("zip_code")
  city                 String?
  country              String           @default("DE")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  memberships               Membership[]
  invitations               Invitation[]
  platforms                 Platform[]
  carriers                  Carrier[]
  taxRates                  TaxRate[]
  stockItems                StockItem[]
  sales                     Sale[]
  returns                   Return[]
  consignments              ConsignmentInventory[]
  debts                     Debt[]
  tasks                     Task[]
  credentials               Credential[]
  auditLogs                 AuditLog[]
  listings                  StockItemListing[]
  shippingRates             ShippingRate[]
  saleItems                 SaleItem[]
  selectOptions             SelectOption[]
  products                  Product[]
  // Phase 1 – additives Datenmodell
  documentSequences         DocumentSequence[]
  purchases                 Purchase[]
  purchaseLines             PurchaseLine[]
  purchaseReceipts          PurchaseReceipt[]
  purchaseReceiptLines      PurchaseReceiptLine[]
  inventoryPositions        InventoryPosition[]
  ownedStockLots            OwnedStockLot[]
  consignmentLots           ConsignmentLot[]
  inventoryMovements        InventoryMovement[]
  inventoryPositionListings InventoryPositionListing[]
  saleLines                 SaleLine[]
  saleLineAllocations       SaleLineAllocation[]
  returnLines               ReturnLine[]
  returnAllocations         ReturnAllocation[]
  debtPurchaseLinks         DebtPurchaseLink[]
  debtSaleLinks             DebtSaleLink[]
  debtInventoryLinks        DebtInventoryLink[]
  importBatches             ImportBatch[]
  sourceReferences          SourceReference[]
  businessPartners          BusinessPartner[]
  businessPartnerRoles      BusinessPartnerRole[]
  marketplaceAccounts       MarketplaceAccount[]
  payoutAccounts            PayoutAccount[]
  expenseCategories         ExpenseCategory[]
  expenses                  Expense[]
  expenseRecurrenceRules    ExpenseRecurrenceRule[]
  supplierReturns           SupplierReturn[]
  supplierReturnLines       SupplierReturnLine[]
  taskAssignments           TaskAssignment[]
  taskChecklistItems        TaskChecklistItem[]
  taskActivities            TaskActivity[]
  feeSchedules              FeeSchedule[]
  feeRules                  FeeRule[]
  featureEntitlements       FeatureEntitlement[]

  @@map("organizations")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash") // null bei reinem OAuth-Login
  // 2FA (TOTP) – Secret verschlüsselt (AES-256-GCM, lib/crypto.ts)
  totpSecret    String?   @map("totp_secret")
  totpEnabled   Boolean   @default(false) @map("totp_enabled")
  recoveryCodes String[]  @default([]) @map("recovery_codes") // argon2-Hashes
  // Dark-Mode-Präferenz: "light" | "dark" | null = Systemeinstellung
  theme         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts                Account[]
  sessions                Session[]
  memberships             Membership[]
  sentInvitations         Invitation[]
  assignedTasks           Task[]              @relation("TaskAssignee")
  createdTasks            Task[]              @relation("TaskCreator")
  createdPurchases        Purchase[]          @relation("PurchaseCreatedBy")
  purchaseReceiptsCreated PurchaseReceipt[]   @relation("PurchaseReceiptCreatedBy")
  inventoryMovements      InventoryMovement[] @relation("InventoryMovementCreatedBy")
  auditLogs               AuditLog[]
  importBatches           ImportBatch[]       @relation("ImportBatchCreatedBy")
  supplierReturnsCreated  SupplierReturn[]    @relation("SupplierReturnCreatedBy")
  taskAssignments         TaskAssignment[]
  completedChecklistItems TaskChecklistItem[] @relation("TaskChecklistCompletedBy")
  taskActivities          TaskActivity[]      @relation("TaskActivityActor")

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  email          String
  role           Role             @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Stammdaten (mandantenspezifisch)
// ---------------------------------------------------------------------------

model Platform {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String // z.B. eBay, Vinted, Kleinanzeigen
  url               String?
  defaultFeePercent Decimal  @default(0) @map("default_fee_percent") @db.Decimal(5, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales               Sale[]
  credentials         Credential[]
  listings            StockItemListing[]
  inventoryListings   InventoryPositionListing[]
  marketplaceAccounts MarketplaceAccount[]
  feeRules            FeeRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("platforms")
}

// Konfigurierbare Versandtarife (ersetzt feste DHL-Tabelle):
// Zielland + Gewicht -> Grundpreis + Kilopreis + Zuschläge (lib/calculations.ts)
model ShippingRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  carrierName    String   @map("carrier_name") // z.B. DHL, DPD, Hermes, GLS, UPS
  name           String // Tarifname, z.B. "Paket M national"
  zone           String // Zonenlabel, z.B. "DE", "EU", "Welt"
  countries      String[] @default([]) // ISO-2-Länder der Zone; leer = alle
  baseCents      Int      @map("base_cents") // Grundpreis
  perKgCents     Int      @default(0) @map("per_kg_cents") // Kilopreis
  maxWeightKg    Decimal? @map("max_weight_kg") @db.Decimal(6, 2) // optionales Tarif-Limit
  // Zuschläge als JSON: [{ "label": "Sperrgut", "cents": 500 }, ...]
  surcharges     Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("shipping_rates")
}

model Carrier {
  id                  String   @id @default(cuid())
  organizationId      String   @map("organization_id")
  name                String // z.B. DHL, Hermes, DPD
  trackingUrlTemplate String?  @map("tracking_url_template") // z.B. https://.../{tracking}
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("carriers")
}

model TaxRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String // z.B. "Differenzbesteuerung §25a", "Regelsteuersatz 19%"
  ratePercent    Decimal  @map("rate_percent") @db.Decimal(5, 2)
  // ISO-2-Länderkürzel (z.B. "DE", "AT"); null = Fallback für alle Länder.
  // Verkäufe nutzen den Satz des Käuferlands, sonst den Default.
  country        String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItems   StockItem[]
  sales        Sale[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Warenwirtschaft
// ---------------------------------------------------------------------------

model StockItem {
  id                 String          @id @default(cuid())
  organizationId     String          @map("organization_id")
  sku                String // interne Artikelnummer
  title              String
  model              String? // Modell (z.B. "Air Jordan 1 Mid")
  variant            String? // Variante/Colorway
  description        String?
  category           String?
  brand              String?
  size               String?
  condition          String? // z.B. "Neu mit Etikett", "Sehr gut"
  itemCondition      ItemCondition?  @map("item_condition")
  ean                String? // EAN/GTIN
  quantity           Int             @default(1)
  supplier           String? // Händler / Bezugsquelle
  purchasePriceCents Int             @map("purchase_price_cents") // EK brutto in Cent
  // EK netto: bei Vorsteuerabzug = brutto / (1 + Satz), sonst = brutto
  purchaseNetCents   Int?            @map("purchase_net_cents")
  inputTaxDeductible Boolean         @default(false) @map("input_tax_deductible")
  paymentMethod      String?         @map("payment_method") // z.B. PayPal, Bar, Überweisung
  purchaseDate       DateTime?       @map("purchase_date")
  purchaseChannel    String?         @map("purchase_channel") // wo eingekauft
  location           String? // Lagerplatz
  status             StockItemStatus @default(IN_STOCK)
  // Buchungsstatus wie im Excel: Kauf (E/O/NN) und Retoure (E/O/NN/S)
  kaufStatus         EntryStatus     @default(O) @map("kauf_status")
  retoureStatus      EntryStatus     @default(NN) @map("retoure_status")
  imageUrls          String[]        @default([]) @map("image_urls")
  notes              String?
  taxRateId          String?         @map("tax_rate_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate      TaxRate?               @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  sales        Sale[]
  saleItems    SaleItem[]
  consignments ConsignmentInventory[]
  listings     StockItemListing[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("stock_items")
}

// "Gelistet auf": n:m zwischen StockItem und Platform (nicht hartcodiert)
model StockItemListing {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  stockItemId    String   @map("stock_item_id")
  platformId     String   @map("platform_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, platformId])
  @@index([organizationId])
  @@map("stock_item_listings")
}

// Verkaufsposition: verknüpft einen Verkauf mit genau einer Einheit aus dem
// Lager ODER dem Konsignationsbestand (Mehrartikel-Verkäufe = mehrere Zeilen)
model SaleItem {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  saleId         String  @map("sale_id")
  stockItemId    String? @map("stock_item_id")
  consignmentId  String? @map("consignment_id")
  ekNetCents     Int     @default(0) @map("ek_net_cents") // EK-Netto-Snapshot

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItem    StockItem?            @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  consignment  ConsignmentInventory? @relation(fields: [consignmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([saleId])
  @@map("sale_items")
}

// Konfigurierbare Dropdown-Werte (ZM, Auszahlungsempfänger)
model SelectOption {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  kind           OptionKind
  label          String
  sortOrder      Int        @default(0) @map("sort_order")
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, label])
  @@index([organizationId])
  @@map("select_options")
}

// Produktkatalog: wiederkehrende Produkte für schnelles Eintragen
model Product {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String
  brand             String?
  variant           String? // Variante/Version
  size              String? // Größe (Phase-1-Ergänzung fürs neue Datenmodell)
  category          String?
  ean               String?
  defaultPriceCents Int?     @map("default_price_cents") // Standard-EK brutto
  imageUrls         String[] @default([]) @map("image_urls")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseLines      PurchaseLine[]
  inventoryPositions InventoryPosition[]
  saleLines          SaleLine[]

  @@unique([organizationId, name, variant])
  @@index([organizationId])
  @@map("products")
}

model Sale {
  id                       String                   @id @default(cuid())
  organizationId           String                   @map("organization_id")
  stockItemId              String?                  @map("stock_item_id") // Alt-Feld; neue Verkäufe nutzen SaleItem
  platformId               String                   @map("platform_id")
  marketplaceAccountId     String?                  @map("marketplace_account_id")
  payoutAccountId          String?                  @map("payout_account_id")
  carrierId                String?                  @map("carrier_id")
  taxRateId                String?                  @map("tax_rate_id")
  soldAt                   DateTime                 @default(now()) @map("sold_at")
  quantity                 Int                      @default(1)
  salePriceCents           Int                      @map("sale_price_cents") // VK brutto in Cent
  // Server-seitig berechnet (lib/calculations.ts) und als Snapshot gespeichert:
  saleNetCents             Int                      @default(0) @map("sale_net_cents") // VK netto
  taxRatePercent           Decimal                  @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  marginCents              Int                      @default(0) @map("margin_cents") // VK netto - EK netto
  profitCents              Int                      @default(0) @map("profit_cents") // Marge - Versand - Gebühren
  buyerCountry             String                   @default("DE") @map("buyer_country") // ISO-2
  shippingMethod           String?                  @map("shipping_method")
  payoutRecipient          String?                  @map("payout_recipient") // Auszahlungsempfänger
  shippingChargedCents     Int                      @default(0) @map("shipping_charged_cents") // Versand vom Käufer
  shippingCostCents        Int                      @default(0) @map("shipping_cost_cents") // Versand netto
  platformFeeCents         Int                      @default(0) @map("platform_fee_cents") // Plattformgebühren brutto
  platformFeeNetCents      Int                      @default(0) @map("platform_fee_net_cents") // berechnet oder manuell
  feeInclVat               Boolean                  @default(true) @map("fee_incl_vat") // Gebühren inkl. MwSt?
  paymentFeeCents          Int                      @default(0) @map("payment_fee_cents") // Alt-Feld (in Plattformgebühren aufgegangen)
  // Informative Checkbox-Status:
  invoiceCreated           Boolean                  @default(false) @map("invoice_created")
  postageBooked            Boolean                  @default(false) @map("postage_booked")
  feesBooked               Boolean                  @default(false) @map("fees_booked")
  buyerUsername            String?                  @map("buyer_username")
  orderNumber              String?                  @map("order_number") // lesbare Order-ID (Format konfigurierbar)
  trackingNumber           String?                  @map("tracking_number")
  status                   SaleStatus               @default(PENDING)
  historicalRelationStatus HistoricalRelationStatus @default(LINKED) @map("historical_relation_status")
  notes                    String?
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem          StockItem?             @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  platform           Platform               @relation(fields: [platformId], references: [id], onDelete: Restrict)
  marketplaceAccount MarketplaceAccount?    @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)
  payoutAccount      PayoutAccount?         @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)
  carrier            Carrier?               @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  taxRate            TaxRate?               @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  saleLines          SaleLine[]
  returns            Return[]
  consignments       ConsignmentInventory[]
  debtLinks          DebtSaleLink[]

  @@index([organizationId])
  @@index([organizationId, soldAt])
  @@index([organizationId, status])
  @@index([marketplaceAccountId])
  @@index([payoutAccountId])
  @@map("sales")
}

model Return {
  id                  String       @id @default(cuid())
  organizationId      String       @map("organization_id")
  returnNumber        String?      @map("return_number")
  saleId              String       @map("sale_id") // harter FK auf den Verkauf
  requestedAt         DateTime     @default(now()) @map("requested_at") // Meldedatum
  receivedAt          DateTime?    @map("received_at")
  reason              String?
  refundAmountCents   Int          @default(0) @map("refund_amount_cents") // Erstattung brutto
  returnShippingCents Int          @default(0) @map("return_shipping_cents") // Zusatzkosten (z.B. Rückversand)
  // Tatsächlicher finanzieller Verlust, server-seitig berechnet
  // (lib/calculations.ts calcReturnLoss): Erstattung abzüglich enthaltener
  // USt und anteiliger Gebühren/Versand, plus Zusatzkosten.
  lossCents           Int          @default(0) @map("loss_cents")
  status              ReturnStatus @default(REQUESTED)
  restocked           Boolean      @default(false) // wieder in den Bestand aufgenommen?
  notes               String?
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returnLines  ReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("returns")
}

model ReturnLine {
  id                String         @id @default(cuid())
  organizationId    String         @map("organization_id")
  returnId          String         @map("return_id")
  saleLineId        String         @map("sale_line_id")
  quantity          Int
  problemType       String?        @map("problem_type")
  condition         String?
  itemCondition     ItemCondition? @map("item_condition")
  refundAmountCents Int?           @map("refund_amount_cents")
  extraCostsCents   Int?           @map("extra_costs_cents")
  comment           String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  return            Return             @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleLine          SaleLine           @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  returnAllocations ReturnAllocation[]

  @@index([organizationId])
  @@index([returnId])
  @@index([saleLineId])
  @@map("return_lines")
}

model ReturnAllocation {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  returnLineId         String   @map("return_line_id")
  saleLineAllocationId String   @map("sale_line_allocation_id")
  quantity             Int
  receiptMovementId    String?  @map("receipt_movement_id")
  restockMovementId    String?  @map("restock_movement_id")
  defectiveMovementId  String?  @map("defective_movement_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnLine         ReturnLine         @relation(fields: [returnLineId], references: [id], onDelete: Cascade)
  saleLineAllocation SaleLineAllocation @relation(fields: [saleLineAllocationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([returnLineId])
  @@index([saleLineAllocationId])
  @@map("return_allocations")
}

model ConsignmentInventory {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  sku               String // eigene SKU/ID für Fremdfirmen-Ware
  stockItemId       String?           @map("stock_item_id") // optional mit Lagerartikel verknüpft
  saleId            String?           @map("sale_id") // (Alt-Feld) einzelner Verkauf
  consignorName     String            @map("consignor_name") // Partnerfirma / Einlieferer
  consignorContact  String?           @map("consignor_contact")
  itemTitle         String            @map("item_title")
  // Bestandszähler
  quantity          Int               @default(0) // aktueller Bestand
  soldQuantity      Int               @default(0) @map("sold_quantity")
  returnedQuantity  Int               @default(0) @map("returned_quantity")
  defectiveQuantity Int               @default(0) @map("defective_quantity")
  // Mehrere Preisebenen als JSON: [{ "label": "VK Standard", "cents": 4999 }, ...]
  priceTiers        Json              @default("[]") @map("price_tiers")
  // Verknüpfung zu echten Sale-Einträgen für separate Umsatz-/Margen-Auswertung
  linkedSaleIds     String[]          @default([]) @map("linked_sale_ids")
  commissionPercent Decimal?          @map("commission_percent") @db.Decimal(5, 2) // unsere Provision
  agreedPayoutCents Int?              @map("agreed_payout_cents") // alternativ: fester Auszahlungsbetrag
  receivedAt        DateTime          @default(now()) @map("received_at")
  soldAt            DateTime?         @map("sold_at")
  paidOutAt         DateTime?         @map("paid_out_at")
  returnedAt        DateTime?         @map("returned_at")
  status            ConsignmentStatus @default(RECEIVED)
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItems    SaleItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("consignment_inventory")
}

model Debt {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  debtNumber     String?    @map("debt_number")
  debtDate       DateTime   @default(now()) @map("debt_date") // Datum der Forderung
  refId          String?    @map("ref_id") // Lager- oder Order-ID
  type           DebtType   @default(MANUAL) @map("debt_type")
  kind           DebtKind   @default(SONSTIGES) // Kauf / Verkauf / Sonstiges
  quantity       Int        @default(1) // Menge
  entryStatus    DebtEntry  @default(IO) @map("entry_status") // I.O / Fehlt
  creditorName   String     @map("creditor_name") // Empfänger
  debtorName     String     @map("debtor_name") // Schuldner
  amountCents    Int        @map("amount_cents")
  paidCents      Int        @default(0) @map("paid_cents")
  description    String?
  dueDate        DateTime?  @map("due_date")
  status         DebtStatus @default(OPEN)
  settledAt      DateTime?  @map("settled_at")
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseLink   DebtPurchaseLink?
  saleLink       DebtSaleLink?
  inventoryLinks DebtInventoryLink[]

  @@unique([organizationId, debtNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("debts")
}

model DebtPurchaseLink {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  debtId         String   @unique @map("debt_id")
  purchaseId     String   @unique @map("purchase_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debt         Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  purchase     Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, purchaseId])
  @@map("debt_purchase_links")
}

model DebtSaleLink {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  debtId         String   @unique @map("debt_id")
  saleId         String   @unique @map("sale_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debt         Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, saleId])
  @@map("debt_sale_links")
}

model DebtInventoryLink {
  id                  String   @id @default(cuid())
  organizationId      String   @map("organization_id")
  debtId              String   @map("debt_id")
  inventoryPositionId String   @map("inventory_position_id")
  createdAt           DateTime @default(now()) @map("created_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debt              Debt              @relation(fields: [debtId], references: [id], onDelete: Cascade)
  inventoryPosition InventoryPosition @relation(fields: [inventoryPositionId], references: [id], onDelete: Cascade)

  @@unique([debtId, inventoryPositionId])
  @@index([organizationId])
  @@index([organizationId, inventoryPositionId])
  @@map("debt_inventory_links")
}

model Task {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  title           String
  description     String?
  area            String? // Bereich, z.B. "Einkauf", "Versand", "Buchhaltung"
  status          TaskStatus   @default(OPEN)
  priority        TaskPriority @default(MEDIUM)
  scope           TaskScope?
  progressPercent Int          @default(0) @map("progress_percent")
  // Erledigte Aufgaben werden archiviert statt gelöscht (Filter im Board)
  archived        Boolean      @default(false)
  dueDate         DateTime?    @map("due_date")
  assigneeId      String?      @map("assignee_id")
  createdById     String       @map("created_by_id")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee       User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignments    TaskAssignment[]
  checklistItems TaskChecklistItem[]
  activities     TaskActivity[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model ImportBatch {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  fileName       String            @map("file_name")
  fileHash       String            @map("file_hash")
  importType     String            @map("import_type")
  status         ImportBatchStatus @default(RUNNING)
  startedAt      DateTime          @default(now()) @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  createdById    String?           @map("created_by_id")
  summary        Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("ImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sourceReferences SourceReference[]

  @@index([organizationId])
  @@index([organizationId, importType])
  @@index([organizationId, fileHash])
  @@map("import_batches")
}

model SourceReference {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  importBatchId   String             @map("import_batch_id")
  sheetName       String?            @map("sheet_name")
  rowNumber       Int                @map("row_number")
  rowHash         String             @map("row_hash")
  targetEntity    ImportTargetEntity @map("target_entity")
  targetEntityId  String             @map("target_entity_id")
  legacyReference String?            @map("legacy_reference")
  status          ImportRowStatus
  warnings        String[]           @default([])
  errors          String[]           @default([])
  createdAt       DateTime           @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importBatch  ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, rowHash, targetEntity, legacyReference])
  @@index([organizationId])
  @@index([organizationId, legacyReference])
  @@index([organizationId, targetEntity, targetEntityId])
  @@index([importBatchId])
  @@map("source_references")
}

model Credential {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  platformId           String?   @map("platform_id")
  marketplaceAccountId String?   @map("marketplace_account_id")
  label                String // z.B. "eBay Hauptaccount"
  username             String?
  // Verschlüsselt mit AES-256-GCM (lib/crypto.ts) – niemals Klartext speichern
  secretEncrypted      String    @map("secret_encrypted")
  notes                String?
  lastRotatedAt        DateTime? @map("last_rotated_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform           Platform?           @relation(fields: [platformId], references: [id], onDelete: SetNull)
  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([marketplaceAccountId])
  @@map("credentials")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String // z.B. "sale.create", "member.role_change"
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) Adapter-Tabellen
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================================================
// Phase 1 (inventory-refactor): Additives Datenfundament
// Ohne Umschaltung – bestehende Modelle (StockItem, Sale, SaleItem,
// ConsignmentInventory, Debt) bleiben in dieser Phase produktiv aktiv.
// Siehe docs/inventory-refactor-plan.md
// ===========================================================================

// ---------------------------------------------------------------------------
// Sichtbare Dokumentnummern je Mandant + Jahr + Dokumentart.
// value wird atomar über increment inkrementiert (Postgres INSERT ... ON
// CONFLICT DO UPDATE SET value = value + 1 RETURNING value).
// Die sichtbare Nummer selbst (z.B. L-26-0001) ist KEIN Primary Key.
// ---------------------------------------------------------------------------

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  kind           DocumentKind
  year           Int
  value          Int          @default(0) // zuletzt vergebene Nummer
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, year])
  @@index([organizationId])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Purchase / PurchaseLine – Einkaufsbeleg mit Positionen
// Geldbeträge als Decimal(12,2) für exakte Buchhaltung.
// ---------------------------------------------------------------------------

model Purchase {
  id                  String                 @id @default(cuid())
  organizationId      String                 @map("organization_id")
  purchaseNumber      String                 @map("purchase_number") // z.B. "E-26-0001"
  purchaseDate        DateTime               @map("purchase_date")
  vendor              String
  paymentMethod       String                 @map("payment_method")
  businessPartnerId   String?                @map("business_partner_id")
  paymentAccountId    String?                @map("payment_account_id")
  supplierOrderNumber String?                @map("supplier_order_number")
  expectedDeliveryAt  DateTime?              @map("expected_delivery_at")
  receivedAt          DateTime?              @map("received_at")
  shippingCarrier     String?                @map("shipping_carrier")
  trackingNumber      String?                @map("tracking_number")
  shippingStatus      PurchaseShippingStatus @default(NOT_SHIPPED) @map("shipping_status")
  returnDeadline      DateTime?              @map("return_deadline")
  documentReference   String?                @map("document_reference")
  purchaseStatus      PurchaseStatus         @default(DRAFT) @map("purchase_status")
  comment             String?
  createdById         String                 @map("created_by_id")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines           PurchaseLine[]
  debtLinks       DebtPurchaseLink[]
  businessPartner BusinessPartner?   @relation(fields: [businessPartnerId], references: [id], onDelete: SetNull)
  paymentAccount  PayoutAccount?     @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  supplierReturns SupplierReturn[]
  receipts        PurchaseReceipt[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId])
  @@index([organizationId, purchaseDate])
  @@index([organizationId, purchaseStatus])
  @@index([organizationId, shippingStatus])
  @@index([organizationId, returnDeadline])
  @@index([createdById])
  @@index([businessPartnerId])
  @@index([paymentAccountId])
  @@map("purchases")
}

model PurchaseLine {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  purchaseId     String   @map("purchase_id")
  productId      String   @map("product_id")
  quantity       Int
  unitPriceGross Decimal  @map("unit_price_gross") @db.Decimal(12, 2)
  unitPriceNet   Decimal  @map("unit_price_net") @db.Decimal(12, 2)
  vatDeductible  Boolean  @default(false) @map("vat_deductible")
  totalGross     Decimal  @map("total_gross") @db.Decimal(12, 2)
  totalNet       Decimal  @map("total_net") @db.Decimal(12, 2)
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase            Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  ownedLots           OwnedStockLot[]
  supplierReturnLines SupplierReturnLine[]
  receiptLines        PurchaseReceiptLine[]

  @@index([organizationId])
  @@index([purchaseId])
  @@map("purchase_lines")
}

model PurchaseReceipt {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  purchaseId        String   @map("purchase_id")
  receivedAt        DateTime @map("received_at")
  shippingCarrier   String?  @map("shipping_carrier")
  trackingNumber    String?  @map("tracking_number")
  documentReference String?  @map("document_reference")
  notes             String?
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase     Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("PurchaseReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines        PurchaseReceiptLine[]

  @@index([organizationId])
  @@index([organizationId, receivedAt])
  @@index([purchaseId])
  @@index([createdById])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                  String                  @id @default(cuid())
  organizationId      String                  @map("organization_id")
  purchaseReceiptId   String                  @map("purchase_receipt_id")
  purchaseLineId      String                  @map("purchase_line_id")
  inventoryPositionId String                  @unique @map("inventory_position_id")
  inboundMovementId   String                  @unique @map("inbound_movement_id")
  quantity            Int
  itemCondition       ItemCondition?          @map("item_condition")
  legacyCondition     String?                 @map("legacy_condition")
  inspectionStatus    ReceiptInspectionStatus @default(PASSED) @map("inspection_status")
  returnDeadline      DateTime?               @map("return_deadline")
  notes               String?
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseReceipt   PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseLine      PurchaseLine      @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  inventoryPosition InventoryPosition @relation(fields: [inventoryPositionId], references: [id], onDelete: Restrict)
  inboundMovement   InventoryMovement @relation("PurchaseReceiptMovement", fields: [inboundMovementId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([purchaseReceiptId])
  @@index([purchaseLineId])
  @@index([organizationId, returnDeadline])
  @@map("purchase_receipt_lines")
}

// ---------------------------------------------------------------------------
// InventoryPosition – gemeinsame Basistabelle für eigenen und Konsignations-
// bestand. Genau EIN OwnedStockLot ODER genau EIN ConsignmentLot pro
// Position (siehe unique-Constraints auf den Spezialisierungen).
// Mengen dürfen nicht negativ sein (CHECK-Constraints in der Migration).
// ---------------------------------------------------------------------------

model InventoryPosition {
  id                 String         @id @default(cuid())
  organizationId     String         @map("organization_id")
  productId          String         @map("product_id")
  inventoryType      InventoryType  @map("inventory_type")
  inventoryNumber    String         @map("inventory_number") // z.B. "L-26-0001" oder "K-26-0001"
  itemCondition      ItemCondition? @map("item_condition")
  quantityReceived   Int            @default(0) @map("quantity_received")
  quantityAvailable  Int            @default(0) @map("quantity_available")
  quantityReserved   Int            @default(0) @map("quantity_reserved")
  quantityInspection Int            @default(0) @map("quantity_inspection")
  quantityDefective  Int            @default(0) @map("quantity_defective")
  quantitySold       Int            @default(0) @map("quantity_sold")
  active             Boolean        @default(true)
  receivedAt         DateTime       @default(now()) @map("received_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product             Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  ownedLot            OwnedStockLot?
  consignmentLot      ConsignmentLot?
  movements           InventoryMovement[]
  listings            InventoryPositionListing[]
  saleAllocations     SaleLineAllocation[]
  debtLinks           DebtInventoryLink[]
  supplierReturnLines SupplierReturnLine[]
  purchaseReceiptLine PurchaseReceiptLine?

  @@unique([organizationId, inventoryNumber])
  @@index([organizationId])
  @@index([organizationId, inventoryType])
  @@index([organizationId, active])
  @@map("inventory_positions")
}

// ---------------------------------------------------------------------------
// OwnedStockLot – Spezialisierung für eigenen Bestand.
// EntryStatus-Enums werden wiederverwendet (Kauf: E/O/NN, Retoure: E/O/NN/S).
// ---------------------------------------------------------------------------

model OwnedStockLot {
  id                  String      @id @default(cuid())
  inventoryPositionId String      @unique @map("inventory_position_id")
  organizationId      String      @map("organization_id")
  purchaseLineId      String?     @map("purchase_line_id") // Übergangsphase: optional
  purchaseDate        DateTime    @map("purchase_date")
  vendor              String
  unitPriceGross      Decimal     @map("unit_price_gross") @db.Decimal(12, 2)
  unitPriceNet        Decimal     @map("unit_price_net") @db.Decimal(12, 2)
  vatDeductible       Boolean     @default(false) @map("vat_deductible")
  paymentMethod       String      @map("payment_method")
  purchaseEntryStatus EntryStatus @default(O) @map("purchase_entry_status")
  returnEntryStatus   EntryStatus @default(NN) @map("return_entry_status")
  ean                 String?
  imageUrls           String[]    @default([]) @map("image_urls")
  legacySource        String?     @map("legacy_source") // z.B. "stock_items:<id>" (Backfill)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryPosition InventoryPosition @relation(fields: [inventoryPositionId], references: [id], onDelete: Cascade)
  purchaseLine      PurchaseLine?     @relation(fields: [purchaseLineId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("owned_stock_lots")
}

model InventoryPositionListing {
  id                  String @id @default(cuid())
  organizationId      String @map("organization_id")
  inventoryPositionId String @map("inventory_position_id")
  platformId          String @map("platform_id")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryPosition InventoryPosition @relation(fields: [inventoryPositionId], references: [id], onDelete: Cascade)
  platform          Platform          @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([inventoryPositionId, platformId])
  @@index([organizationId])
  @@index([platformId])
  @@map("inventory_position_listings")
}

// ---------------------------------------------------------------------------
// ConsignmentLot – Spezialisierung für Konsignationsbestand.
// Beträge als Decimal; channelPrices als JSON (mehrere Preisebenen).
// ---------------------------------------------------------------------------

model ConsignmentLot {
  id                   String   @id @default(cuid())
  inventoryPositionId  String   @unique @map("inventory_position_id")
  organizationId       String   @map("organization_id")
  partnerCompany       String   @map("partner_company")
  businessPartnerId    String?  @map("business_partner_id")
  externalSku          String?  @map("external_sku")
  identificationNumber String?  @map("identification_number")
  costGross            Decimal? @map("cost_gross") @db.Decimal(12, 2)
  costNet              Decimal? @map("cost_net") @db.Decimal(12, 2)
  settlementAmount     Decimal? @map("settlement_amount") @db.Decimal(12, 2)
  shippingCost         Decimal? @map("shipping_cost") @db.Decimal(12, 2)
  realRrpGross         Decimal? @map("real_rrp_gross") @db.Decimal(12, 2)
  // Preisebenen je Verkaufskanal: [{ "channel": "eBay R", "priceGross": 49.99 }, ...]
  channelPrices        Json     @default("[]") @map("channel_prices")
  comment              String?
  legacySource         String?  @map("legacy_source") // z.B. "consignment_inventory:<id>" (Backfill)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryPosition InventoryPosition @relation(fields: [inventoryPositionId], references: [id], onDelete: Cascade)
  businessPartner   BusinessPartner?  @relation(fields: [businessPartnerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, partnerCompany])
  @@index([businessPartnerId])
  @@map("consignment_lots")
}

model InventoryMovement {
  id                  String                @id @default(cuid())
  organizationId      String                @map("organization_id")
  inventoryPositionId String                @map("inventory_position_id")
  movementType        InventoryMovementType @map("movement_type")
  quantity            Int
  fromBucket          InventoryBucket?      @map("from_bucket")
  toBucket            InventoryBucket?      @map("to_bucket")
  referenceType       String?               @map("reference_type")
  referenceId         String?               @map("reference_id")
  referenceAction     String?               @map("reference_action")
  idempotencyKey      String?               @map("idempotency_key")
  comment             String?
  createdById         String?               @map("created_by_id")
  createdAt           DateTime              @default(now()) @map("created_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryPosition   InventoryPosition    @relation(fields: [inventoryPositionId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  supplierReturnLine  SupplierReturnLine?  @relation("SupplierReturnMovement")
  purchaseReceiptLine PurchaseReceiptLine? @relation("PurchaseReceiptMovement")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, inventoryPositionId, createdAt])
  @@index([organizationId, referenceType, referenceId])
  @@index([createdById])
  @@map("inventory_movements")
}

model SaleLine {
  id                  String   @id @default(cuid())
  organizationId      String   @map("organization_id")
  saleId              String   @map("sale_id")
  productId           String   @map("product_id")
  descriptionSnapshot String   @map("description_snapshot")
  variantSnapshot     String?  @map("variant_snapshot")
  sizeSnapshot        String?  @map("size_snapshot")
  quantity            Int
  unitGrossPrice      Decimal  @map("unit_gross_price") @db.Decimal(12, 2)
  grossAmount         Decimal  @map("gross_amount") @db.Decimal(12, 2)
  netAmount           Decimal  @map("net_amount") @db.Decimal(12, 2)
  comment             String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations  SaleLineAllocation[]
  returnLines  ReturnLine[]

  @@index([organizationId])
  @@index([saleId])
  @@index([productId])
  @@map("sale_lines")
}

model SaleLineAllocation {
  id                            String        @id @default(cuid())
  organizationId                String        @map("organization_id")
  saleLineId                    String        @map("sale_line_id")
  inventoryPositionId           String        @map("inventory_position_id")
  quantity                      Int
  unitCostNetSnapshot           Decimal       @map("unit_cost_net_snapshot") @db.Decimal(12, 2)
  inventoryTypeSnapshot         InventoryType @map("inventory_type_snapshot")
  consignmentSettlementSnapshot Decimal?      @map("consignment_settlement_snapshot") @db.Decimal(12, 2)
  createdAt                     DateTime      @default(now()) @map("created_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleLine          SaleLine           @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  inventoryPosition InventoryPosition  @relation(fields: [inventoryPositionId], references: [id], onDelete: Restrict)
  returnAllocations ReturnAllocation[]

  @@index([organizationId])
  @@index([saleLineId])
  @@index([inventoryPositionId])
  @@map("sale_line_allocations")
}

// Beta domain foundation: additive commercial references and capabilities.
// Existing free-text snapshots and production workflows remain unchanged.

model BusinessPartner {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  displayName    String   @map("display_name")
  legalName      String?  @map("legal_name")
  externalRef    String?  @map("external_ref")
  email          String?
  phone          String?
  notes          String?
  active         Boolean  @default(true)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles           BusinessPartnerRole[]
  purchases       Purchase[]
  consignmentLots ConsignmentLot[]
  payoutAccounts  PayoutAccount[]
  expenses        Expense[]
  supplierReturns SupplierReturn[]

  @@unique([organizationId, displayName])
  @@index([organizationId])
  @@index([organizationId, active])
  @@index([organizationId, externalRef])
  @@map("business_partners")
}

model BusinessPartnerRole {
  id                String                  @id @default(cuid())
  organizationId    String                  @map("organization_id")
  businessPartnerId String                  @map("business_partner_id")
  role              BusinessPartnerRoleType
  createdAt         DateTime                @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  @@unique([businessPartnerId, role])
  @@index([organizationId])
  @@map("business_partner_roles")
}

model MarketplaceAccount {
  id                     String                 @id @default(cuid())
  organizationId         String                 @map("organization_id")
  platformId             String                 @map("platform_id")
  displayName            String                 @map("display_name")
  externalAccountId      String?                @map("external_account_id")
  accountType            MarketplaceAccountType @default(BUSINESS) @map("account_type")
  active                 Boolean                @default(true)
  defaultPayoutAccountId String?                @map("default_payout_account_id")
  defaultFeeScheduleId   String?                @map("default_fee_schedule_id")
  metadata               Json                   @default("{}")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform             Platform       @relation(fields: [platformId], references: [id], onDelete: Cascade)
  defaultPayoutAccount PayoutAccount? @relation(fields: [defaultPayoutAccountId], references: [id], onDelete: SetNull)
  defaultFeeSchedule   FeeSchedule?   @relation(fields: [defaultFeeScheduleId], references: [id], onDelete: SetNull)
  sales                Sale[]
  credentials          Credential[]
  feeRules             FeeRule[]

  @@unique([organizationId, platformId, displayName])
  @@index([organizationId])
  @@index([organizationId, active])
  @@index([platformId])
  @@index([defaultPayoutAccountId])
  @@index([defaultFeeScheduleId])
  @@map("marketplace_accounts")
}

model PayoutAccount {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  businessPartnerId String?           @map("business_partner_id")
  displayName       String            @map("display_name")
  accountType       PayoutAccountType @map("account_type")
  externalRef       String?           @map("external_ref")
  currency          String            @default("EUR")
  active            Boolean           @default(true)
  metadata          Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessPartner     BusinessPartner?     @relation(fields: [businessPartnerId], references: [id], onDelete: SetNull)
  marketplaceAccounts MarketplaceAccount[]
  purchases           Purchase[]
  sales               Sale[]
  expenses            Expense[]

  @@unique([organizationId, displayName])
  @@index([organizationId])
  @@index([organizationId, active])
  @@index([businessPartnerId])
  @@map("payout_accounts")
}

model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, active])
  @@map("expense_categories")
}

model Expense {
  id               String        @id @default(cuid())
  organizationId   String        @map("organization_id")
  categoryId       String?       @map("category_id")
  supplierId       String?       @map("supplier_id")
  paymentAccountId String?       @map("payment_account_id")
  description      String
  incurredAt       DateTime      @map("incurred_at")
  amountGross      Decimal       @map("amount_gross") @db.Decimal(12, 2)
  amountNet        Decimal       @map("amount_net") @db.Decimal(12, 2)
  taxRatePercent   Decimal       @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  receiptReference String?       @map("receipt_reference")
  notes            String?
  status           ExpenseStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ExpenseCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier       BusinessPartner?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentAccount PayoutAccount?         @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  recurrence     ExpenseRecurrenceRule?

  @@index([organizationId])
  @@index([organizationId, incurredAt])
  @@index([organizationId, status])
  @@index([categoryId])
  @@index([supplierId])
  @@index([paymentAccountId])
  @@map("expenses")
}

model ExpenseRecurrenceRule {
  id               String                    @id @default(cuid())
  organizationId   String                    @map("organization_id")
  expenseId        String                    @unique @map("expense_id")
  interval         ExpenseRecurrenceInterval
  intervalCount    Int                       @default(1) @map("interval_count")
  rule             String?
  startsAt         DateTime                  @map("starts_at")
  endsAt           DateTime?                 @map("ends_at")
  nextOccurrenceAt DateTime?                 @map("next_occurrence_at")
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expense      Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, active, nextOccurrenceAt])
  @@map("expense_recurrence_rules")
}

model SupplierReturn {
  id               String               @id @default(cuid())
  organizationId   String               @map("organization_id")
  returnNumber     String?              @map("return_number")
  purchaseId       String               @map("purchase_id")
  supplierId       String?              @map("supplier_id")
  supplierSnapshot String               @map("supplier_snapshot")
  status           SupplierReturnStatus @default(DRAFT)
  requestedAt      DateTime             @default(now()) @map("requested_at")
  dispatchedAt     DateTime?            @map("dispatched_at")
  completedAt      DateTime?            @map("completed_at")
  trackingNumber   String?              @map("tracking_number")
  creditReference  String?              @map("credit_reference")
  notes            String?
  createdById      String               @map("created_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase     Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplier     BusinessPartner?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy    User                 @relation("SupplierReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines        SupplierReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, requestedAt])
  @@index([purchaseId])
  @@index([supplierId])
  @@index([createdById])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id                  String         @id @default(cuid())
  organizationId      String         @map("organization_id")
  supplierReturnId    String         @map("supplier_return_id")
  purchaseLineId      String         @map("purchase_line_id")
  inventoryPositionId String         @map("inventory_position_id")
  outboundMovementId  String?        @unique @map("outbound_movement_id")
  quantity            Int
  reason              String?
  legacyCondition     String?        @map("legacy_condition")
  itemCondition       ItemCondition? @map("item_condition")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierReturn    SupplierReturn     @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  purchaseLine      PurchaseLine       @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  inventoryPosition InventoryPosition  @relation(fields: [inventoryPositionId], references: [id], onDelete: Restrict)
  outboundMovement  InventoryMovement? @relation("SupplierReturnMovement", fields: [outboundMovementId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([supplierReturnId])
  @@index([purchaseLineId])
  @@index([inventoryPositionId])
  @@map("supplier_return_lines")
}

model TaskAssignment {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  taskId         String             @map("task_id")
  userId         String             @map("user_id")
  role           TaskAssignmentRole @default(COLLABORATOR)
  createdAt      DateTime           @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("task_assignments")
}

model TaskChecklistItem {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  taskId         String    @map("task_id")
  label          String
  position       Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime? @map("completed_at")
  completedById  String?   @map("completed_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy  User?        @relation("TaskChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([taskId, position])
  @@index([organizationId])
  @@index([completedById])
  @@map("task_checklist_items")
}

model TaskActivity {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  taskId         String   @map("task_id")
  actorId        String?  @map("actor_id")
  action         String
  details        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor        User?        @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([taskId, createdAt])
  @@index([actorId])
  @@map("task_activities")
}

model FeeSchedule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultForAccounts MarketplaceAccount[]
  rules              FeeRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, active])
  @@map("fee_schedules")
}

model FeeRule {
  id                   String          @id @default(cuid())
  organizationId       String          @map("organization_id")
  feeScheduleId        String?         @map("fee_schedule_id")
  platformId           String          @map("platform_id")
  marketplaceAccountId String?         @map("marketplace_account_id")
  category             String?
  itemCondition        ItemCondition?  @map("item_condition")
  validFrom            DateTime        @map("valid_from")
  validUntil           DateTime?       @map("valid_until")
  percentage           Decimal         @default(0) @db.Decimal(7, 4)
  fixedFeeCents        Int             @default(0) @map("fixed_fee_cents")
  minimumFeeCents      Int?            @map("minimum_fee_cents")
  maximumFeeCents      Int?            @map("maximum_fee_cents")
  advertisingPercent   Decimal         @default(0) @map("advertising_percent") @db.Decimal(7, 4)
  paymentFeePercent    Decimal         @default(0) @map("payment_fee_percent") @db.Decimal(7, 4)
  vatTreatment         FeeVatTreatment @default(UNKNOWN) @map("vat_treatment")
  priority             Int             @default(0)
  origin               FeeRuleOrigin   @default(MANUAL)
  source               String?
  active               Boolean         @default(true)
  metadata             Json            @default("{}")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feeSchedule        FeeSchedule?        @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)
  platform           Platform            @relation(fields: [platformId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, active, validFrom, validUntil])
  @@index([platformId])
  @@index([marketplaceAccountId])
  @@index([feeScheduleId])
  @@map("fee_rules")
}

model FeatureEntitlement {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  featureKey     String            @map("feature_key")
  status         EntitlementStatus @default(ACTIVE)
  source         EntitlementSource
  startsAt       DateTime          @default(now()) @map("starts_at")
  endsAt         DateTime?         @map("ends_at")
  externalRef    String?           @map("external_ref")
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, featureKey, status])
  @@index([organizationId, startsAt, endsAt])
  @@map("feature_entitlements")
}
