{
    "name": "storagex",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build --turbopack",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "postinstall": "prisma generate",
        "db:up": "powershell -ExecutionPolicy Bypass -File scripts/db-start.ps1",
        "db:down": "powershell -ExecutionPolicy Bypass -File scripts/db-stop.ps1",
        "db:up:docker": "docker compose up -d",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.2",
