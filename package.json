        "clsx": "^2.1.1",
        "lucide-react": "^1.23.0",
        "next": "15.5.20",
        "next-auth": "^5.0.0-beta.31",
        "next-themes": "^0.4.6",
        "nodemailer": "^7.0.13",
        "otplib": "^12.0.1",
        "qrcode": "^1.5.4",
        "radix-ui": "^1.6.1",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-hook-form": "^7.80.0",
        "recharts": "^3.9.2",
        "sonner": "^2.0.7",
