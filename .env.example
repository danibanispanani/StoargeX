# Kopieren nach .env und Werte eintragen.

# App-User darf kein Postgres-Superuser sein (RLS!)
DATABASE_URL="postgresql://storagex:storagex@localhost:5432/storagex?schema=public"

# Erzeugen: npx auth secret  (oder: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

# Vercel/Supabase Storage fuer Bild-Uploads.
# Bucket in Supabase Storage als public bucket anlegen, z.B. "stock-images".
# SUPABASE_SERVICE_ROLE_KEY nur serverseitig in Vercel setzen, nie im Browser verwenden.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="stock-images"

# Optionaler Demo-/Lizenzcode fuer Einstellungen -> Abo & Abrechnung.
# Leer lassen, um die Funktion zu deaktivieren. DEMO_UPGRADE_TIER: PRO oder BUSINESS.
DEMO_UPGRADE_CODE=""
DEMO_UPGRADE_TIER="BUSINESS"

# Stripe Billing (Test-Keys aus dem Stripe-Dashboard)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="StoargeX <noreply@storagex.local>"
