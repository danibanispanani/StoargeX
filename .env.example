# Kopieren nach .env und Werte eintragen.

# App-User darf kein Postgres-Superuser sein (RLS!)
DATABASE_URL="postgresql://storagex:storagex@localhost:5432/storagex?schema=public"

# Erzeugen: npx auth secret  (oder: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
