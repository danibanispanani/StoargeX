AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

